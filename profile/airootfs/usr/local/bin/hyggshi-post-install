#!/usr/bin/env bash
# Runs in the *target* chroot right after unpackfs. Strips live-ISO leftovers
# so the installed system is a normal Arch install.
set -u

# 1) archiso keeps the kernel on the ISO, not in the squashfs's /boot (mkarchiso empties it).
#    The `linux` package also ships a copy under /usr/lib/modules/<ver>/vmlinuz - use that,
#    otherwise mkinitcpio fails with "/boot/vmlinuz-linux must be readable".
mkdir -p /boot
k=$(ls -1 /usr/lib/modules/*/vmlinuz 2>/dev/null | sort -V | tail -n 1)
if [ -z "$k" ]; then
    echo "hyggshi-post-install: no kernel image found under /usr/lib/modules" >&2
    exit 1
fi
cp -f "$k" /boot/vmlinuz-linux

# 2) strip live-ISO leftovers (must happen BEFORE mkinitcpio runs)
rm -f  /etc/mkinitcpio.conf.d/archiso.conf
rm -f  /etc/sudoers.d/10-liveuser
rm -f  /etc/sddm.conf.d/50-hyggshi-live.conf
rm -f  /etc/systemd/system/getty@tty1.service.d/autologin.conf
rmdir  /etc/systemd/system/getty@tty1.service.d 2>/dev/null
for s in pacman-init choose-mirror livecd-talk livecd-alsa-unmuter hyggshi-live-setup; do
    rm -f "/etc/systemd/system/$s.service" \
          "/etc/systemd/system/multi-user.target.wants/$s.service" \
          "/etc/systemd/system/sound.target.wants/$s.service"
done
rm -f  /etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f  /etc/systemd/system-generators/systemd-gpt-auto-generator
rm -f  /etc/systemd/logind.conf.d/do-not-suspend.conf
rm -f  /etc/systemd/journald.conf.d/volatile-storage.conf
rm -f  /etc/motd /etc/pacman.d/hooks/uncomment-mirrors.hook
rm -f  /root/.automated_script.sh /root/.zlogin
rm -f  /usr/local/bin/{hyggshi-rebrand,hyggshi-live-setup,choose-mirror,livecd-sound,Installation_guide}
rm -rf /usr/local/share/hyggshi /usr/local/share/livecd-sound
# the live ISO's package keyring lives on tmpfs; the installed system needs its own
pacman-key --init && pacman-key --populate archlinux
# the installer itself is not needed on the installed system
pacman -Rns --noconfirm calamares 2>/dev/null
rm -rf /etc/calamares
exit 0
