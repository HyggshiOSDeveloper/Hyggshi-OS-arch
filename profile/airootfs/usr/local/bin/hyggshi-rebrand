#!/bin/sh
# Build-time only (pacman hook, right after `filesystem` is installed).
# /etc/os-release is a symlink owned by `filesystem`, so we can't ship it in airootfs;
# instead we overwrite its target with our own file. mkarchiso appends IMAGE_ID/IMAGE_VERSION later.
src=/usr/local/share/hyggshi/os-release
[ -f "$src" ] && cp -f "$src" /usr/lib/os-release
[ -f /etc/issue ]       && sed -i 's/Arch Linux/Hyggshi OS/' /etc/issue
[ -f /etc/lsb-release ] && sed -i -e 's/^DISTRIB_ID=.*/DISTRIB_ID="Hyggshi"/' -e 's/^DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION="Hyggshi OS"/' /etc/lsb-release
exit 0
