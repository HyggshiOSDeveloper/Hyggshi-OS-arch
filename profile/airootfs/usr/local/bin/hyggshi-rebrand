#!/bin/sh
# Build-time only: rebrand Arch -> Hyggshi OS in files owned by `filesystem`.
f=/usr/lib/os-release
[ -f "$f" ] && sed -i \
  -e 's|^NAME=.*|NAME="Hyggshi OS"|' \
  -e 's|^PRETTY_NAME=.*|PRETTY_NAME="Hyggshi OS (Arch Edition)"|' \
  -e 's|^ID=.*|ID=hyggshi\nID_LIKE=arch|' \
  -e 's|^ANSI_COLOR=.*|ANSI_COLOR="38;2;122;162;247"|' \
  -e 's|^HOME_URL=.*|HOME_URL="https://github.com/Hyggshi-OS-project-center"|' \
  -e 's|^DOCUMENTATION_URL=.*|DOCUMENTATION_URL="https://github.com/Hyggshi-OS-project-center"|' \
  -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/Hyggshi-OS-project-center"|' \
  -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/Hyggshi-OS-project-center"|' \
  -e '/^PRIVACY_POLICY_URL=/d' \
  "$f"
[ -f /etc/issue ]       && sed -i 's/Arch Linux/Hyggshi OS/' /etc/issue
[ -f /etc/lsb-release ] && sed -i -e 's/^DISTRIB_ID=.*/DISTRIB_ID="Hyggshi"/' -e 's/^DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION="Hyggshi OS"/' /etc/lsb-release
exit 0
